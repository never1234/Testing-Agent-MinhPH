# Copy to .env and fill in. Never commit .env.

# Google Sheets (projects with testcases.source: gsheet, or bug_tracker sheet on gsheet)
GOOGLE_SERVICE_ACCOUNT_JSON=secrets/google-sa.json

# Trello  (https://trello.com/power-ups/admin -> API key -> Token)
TRELLO_KEY=
TRELLO_TOKEN=

# Jira Cloud (API token: https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
# Jira Server/Data Center: personal access token instead
JIRA_PAT=

# MantisBT (My Account -> API Tokens)
MANTIS_BASE_URL=https://mantis.yourcompany.com
MANTIS_TOKEN=

# ---- Test accounts (names referenced in projects/<name>/profile.yaml) ----
SHOPX_A_USER=
SHOPX_A_PASS=
SHOPX_B_USER=
SHOPX_B_PASS=
